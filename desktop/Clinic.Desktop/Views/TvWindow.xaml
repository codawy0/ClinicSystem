<Window x:Class="Clinic.Desktop.Views.TvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="شاشة الانتظار - العيادة"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Background="#0f172a"
        ShowInTaskbar="True"
        FlowDirection="RightToLeft">
    <Grid>
        <wv2:WebView2 x:Name="TvWebView" />
        
        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Background="#0f172a" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="عيادة النخبة التخصصية" Foreground="#38bdf8" FontSize="32" FontWeight="Bold" 
                           FontFamily="Cairo, Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="جاري تحميل شاشة الانتظار..." Foreground="#94a3b8" FontSize="20" 
                           FontFamily="Cairo, Segoe UI" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="280" Height="8" Margin="0,24,0,0" Foreground="#0284c7" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
