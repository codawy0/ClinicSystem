{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "ClinicManagementSystemSuperSecretKey2026!MustBeAtLeast32BytesLongForHmacSha256",
    "Issuer": "ClinicSystem",
    "Audience": "ClinicSystemClients",
    "ExpiryHours": 12
  },
  "ClinicStorage": {
    "DataRoot": "./.clinic-data"
  },
  "ClinicSettings": {
    "RolloverHourLocal": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./.clinic-data/clinic.db;"
  }
}
