<Window x:Class="Clinic.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة العيادة الطبية"
        Height="360" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Gradients and Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.35" Color="#000000" />
        
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E293B" Offset="0.6" />
            <GradientStop Color="#0F243A" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0" />
            <GradientStop Color="#10B981" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border CornerRadius="20" Background="{StaticResource BackgroundGradient}" 
            BorderBrush="#334155" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Margin="12">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Medical Emblem -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="14" Background="#0284C7" Margin="0,0,18,0">
                    <Path Data="M19,10.5H13.5V5a1.5,1.5 0 0,0 -3,0V10.5H5a1.5,1.5 0 0,0 0,3H10.5V19a1.5,1.5 0 0,0 3,0V13.5H19a1.5,1.5 0 0,0 0,-3Z" 
                          Fill="#FFFFFF" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="نظام إدارة العيادة الطبية" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Segoe UI, Cairo" />
                    <TextBlock Text="منظومة إدارة الاستشارات والملفات الطبية الذكية v2.0" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Status Content Panel -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,0">
                <TextBlock x:Name="TxtStatus" Text="جاري فحص بيئة التشغيل والخادم..." 
                           FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,12" />
                
                <!-- Modern Progress Bar -->
                <Grid Height="8">
                    <Border CornerRadius="4" Background="#334155" />
                    <ProgressBar x:Name="MainProgressBar" Height="8" Minimum="0" Maximum="100" Value="15" 
                                 Foreground="{StaticResource ProgressGradient}" BorderThickness="0" Background="Transparent" />
                </Grid>
                
                <TextBlock x:Name="TxtPercentage" Text="15%" FontSize="12" Foreground="#64748B" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>

            <!-- 3. Error Panel (Hidden by default) -->
            <StackPanel x:Name="ErrorPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="⚠️ تعذر بدء تشغيل النظام" FontSize="15" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtErrorMessage" Text="حدث خطأ غير متوقع أثناء تشغيل الخادم." 
                           FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="إعادة المحاولة" Width="110" Height="32" Background="#0284C7" Foreground="#FFFFFF" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnRetry_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="فتح مجلد السجلات" Width="130" Height="32" Background="#334155" Foreground="#E2E8F0" 
                            Margin="10,0,0,0" BorderThickness="0" Cursor="Hand" Click="BtnLogs_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="إغلاق" Width="80" Height="32" Background="#475569" Foreground="#E2E8F0" 
                            Margin="10,0,0,0" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 4. Footer Info -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="الوضع المحلي غير المتصل (Offline LAN Mode) • مؤمن ومحمي" 
                           FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                <TextBlock Text="المعالج: ASP.NET Core + WebView2" 
                           FontSize="11" Foreground="#475569" HorizontalAlignment="Left" />
            </Grid>
        </Grid>
    </Border>
</Window>
